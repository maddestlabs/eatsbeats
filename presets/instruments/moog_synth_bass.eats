# @id: moog_synth_bass
# @name: Model D Sub Synth Bass
# @category: instrument
# @description: Analog Sub Synth Bass: dual detuned Saw/Pulse oscillators with dedicated sub-octave square wave, 4-pole 24dB/oct transistor ladder lowpass filter with exponential contour punch, and warm transistor overdrive.

# --- Parameter Definitions ---
def init():
    return {
        "Cutoff": eat.param("Cutoff", 30.0, 8000.0, 350.0, step=0.0),
        "Resonance": eat.param("Resonance", 0.0, 0.95, 0.65, step=0.0),
        "FilterEnv": eat.param("FilterEnv", 0.0, 1.0, 0.65, step=0.0),
        "Decay": eat.param("Decay", 0.05, 3.0, 0.4, step=0.0),
        "AmpDecay": eat.param("AmpDecay", 0.1, 4.0, 0.85, step=0.0),
        "Drive": eat.param("Drive", 0.5, 3.0, 1.25, step=0.0),
    }

