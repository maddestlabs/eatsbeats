                            "size": 48,
                        },
                        {
                            "type": "knob",
                            "param": "EchoFeedback",
                            "label": "ECHO FDBK",
                            "size": 48,
                        },
                        {
                            "type": "knob",
                            "param": "EchoVolume",
                            "label": "ECHO VOL",
                            "size": 48,
