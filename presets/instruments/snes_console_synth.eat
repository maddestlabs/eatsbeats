# @id: snes_console_synth
# @name: SNES Synth
# @category: instrument
# @description: Polyphonic 16-bit console sound processor emulation with Gaussian BRR wavetables, pitch modulation (PMOD), and 8-tap FIR echo reverb.

# --- Parameter Definitions ---
def init():
    return {
        "Waveform": eat.param("Waveform", 0.0, 11.0, 0.0, options=["Square", "Pulse 25%", "Pulse 12%", "Sawtooth", "Triangle", "Sine", "Organ", "Strings", "Flute", "Slap Bass", "Chime", "Noise"], allow_variance=False),
        "Attack": eat.param("Attack", 0.001, 0.5, 0.005, step=0.0),
        "Decay": eat.param("Decay", 0.01, 2.0, 0.3, step=0.0),
        "Sustain": eat.param("Sustain", 0.0, 1.0, 0.5, step=0.0),
        "Release": eat.param("Release", 0.01, 2.0, 0.25, step=0.0),
        "VibratoRate": eat.param("VibratoRate", 0.0, 20.0, 5.5, step=0.0),
        "VibratoDepth": eat.param("VibratoDepth", 0.0, 1.0, 0.1, step=0.0),
        "EchoDelay": eat.param("EchoDelay", 16.0, 480.0, 140.0, step=16.0, allow_variance=False),
        "EchoFeedback": eat.param("EchoFeedback", 0.0, 0.9, 0.55, step=0.0),
        "EchoVolume": eat.param("EchoVolume", 0.0, 1.0, 0.4, step=0.0),
    }

# --- Hardware GUI Layout ---
