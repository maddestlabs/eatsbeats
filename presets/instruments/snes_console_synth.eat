                            "param": "Sustain",
                            "label": "SUSTAIN",
                            "size": 48,
                        },
                        {
                            "type": "knob",
                            "param": "Release",
                            "label": "RELEASE",
                            "size": 48,
                        },
                    ],
                },
                {
                    "type": "row",
                    "children": [
                        {
                            "type": "knob",
                            "param": "VibratoRate",
                            "label": "VIB RATE",
                            "size": 48,
                        },
                        {
                            "type": "knob",
                            "param": "VibratoDepth",
                            "label": "VIB DEPTH",
                            "size": 48,
                        },
                        {
                            "type": "knob",
                            "param": "EchoDelay",
