# @id: poly_lead
# @name: Poly Lead Synth
# @category: instrument
# @description: Dual oscillator sawtooth lead synthesizer with dynamic lowpass filter sweep.

# --- Parameter Definitions ---
def init():
    return {
        "Cutoff": eat.param("Cutoff", 400.0, 12000.0, 4500.0, step=0.0),
        "Resonance": eat.param("Resonance", 0.5, 8.0, 3.0, step=0.0),
        "Detune": eat.param("Detune", 0.0, 10.0, 3.0, step=0.0),
        "Attack": eat.param("Attack", 0.001, 0.1, 0.01, step=0.0),
        "Release": eat.param("Release", 0.05, 1.0, 0.35, step=0.0),
    }

# --- Hardware GUI Layout ---
def gui():
    return {
        "panel": {
            "title": "POLY LEAD SYNTH",
            "subtitle": "Dual Detuned Saw & Dynamic VCF Lead",
            "accent": "track",
            "layout": [
                {
                    "type": "row",
                    "children": [
                        {
                            "type": "knob",
                            "param": "Cutoff",
                            "label": "CUTOFF",
                            "size": 56,
                        },
                        {
                            "type": "knob",
                            "param": "Resonance",
                            "label": "RESO",
                            "size": 56,
                        },
                        {
                            "type": "knob",
                            "param": "Detune",
                            "label": "DETUNE",
                            "size": 52,
                        },
                        {
                            "type": "knob",
                            "param": "Attack",
                            "label": "ATTACK",
                            "size": 52,
                        },
                        {
                            "type": "knob",
                            "param": "Release",
                            "label": "RELEASE",
                            "size": 52,
                        },
                    ],
                },
            ],
        },
    }

# --- Synthesizer Voice DSP Process Hook ---
def process(time, freq, note, params):
    return 0.0

PolyLeadSynth = True
