# @id: eats_sfxr
# @name: SNES Sfxr
# @category: instrument
# @description: Authentic 16-Bit S-DSP Console Engine 16-bit procedural sound effect engine with BRR wavetables, 4-point Gaussian filtering, 8-tap FIR echo reverb, and intelligent PRNG seed randomization. Instant archetypes: Laser, Explosion, Powerup, Coin, Jump, Hurt, Lose, Button, Warp, Mutate, Custom. Completely playable chromatically across keys!

# --- Parameter Definitions ---
def init():
    return {
        "SFXType": eat.param("SFXType", 0.0, 10.0, 0.0, options=["Laser", "Explosion", "Powerup", "Coin", "Jump", "Hurt", "Lose", "Button", "Warp", "Mutate", "Custom SNES"], allow_variance=False),
        "Seed": eat.param("Seed", 1.0, 9999.0, 42.0, step=1.0, allow_variance=False),
        "Waveform": eat.param("Waveform", 0.0, 11.0, 1.0, options=["Sine", "Square", "Pulse 25%", "Pulse 12%", "Sawtooth", "Triangle", "Organ", "Strings", "Flute", "Slap Bass", "Chime", "Noise"], allow_variance=False),
        "Attack": eat.param("Attack", 0.001, 0.5, 0.005, step=0.0),
        "Decay": eat.param("Decay", 0.01, 2.0, 0.35, step=0.0),
        "Sustain": eat.param("Sustain", 0.0, 1.0, 0.2, step=0.0),
        "Release": eat.param("Release", 0.01, 2.0, 0.2, step=0.0),
        "PitchSweep": eat.param("PitchSweep", -2.0, 2.0, -0.45, step=0.0),
        "VibratoRate": eat.param("VibratoRate", 0.0, 20.0, 0.0, step=0.0),
        "VibratoDepth": eat.param("VibratoDepth", 0.0, 1.0, 0.0, step=0.0),
        "EchoDelay": eat.param("EchoDelay", 16.0, 480.0, 120.0, step=16.0, allow_variance=False),
        "EchoFeedback": eat.param("EchoFeedback", 0.0, 0.95, 0.45, step=0.0),
        "EchoVolume": eat.param("EchoVolume", 0.0, 1.0, 0.35, step=0.0),
        "NoiseMix": eat.param("NoiseMix", 0.0, 1.0, 0.0, step=0.0),
    }

