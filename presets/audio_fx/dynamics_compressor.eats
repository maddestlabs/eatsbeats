# @id: dynamics_compressor
# @name: Dynamics Compressor
# @category: audioFx
# @description: Studio dynamic range compressor with adjustable ratio, soft knee, attack, and release.

# --- Parameter Definitions ---
def init():
    return {
        "Threshold": eat.param("Threshold", -40.0, 0.0, -18.0, step=1.0, allow_variance=False),
        "Ratio": eat.param("Ratio", 1.0, 20.0, 4.0, step=0.5),
        "Attack": eat.param("Attack", 0.001, 0.2, 0.02, step=0.005),
        "Release": eat.param("Release", 0.01, 1.0, 0.25, step=0.01),
        "Knee": eat.param("Knee", 0.0, 24.0, 12.0, step=1.0, allow_variance=False),
    }

# --- Hardware GUI Layout ---
def gui():
    return {
        "panel": {
            "title": "Dynamics Compressor",
            "subtitle": "Studio VCA Dynamic Range Compression",
            "background": "dark",
            "accent": "#00FF9D",
            "layout": [
                {
                    "type": "row",
                    "children": [
                        {
                            "type": "knob",
                            "param": "Threshold",
                            "label": "THRESHOLD",
                            "unit": "dB",
                        },
                        {
                            "type": "knob",
                            "param": "Ratio",
                            "label": "RATIO",
                            "unit": ":1",
                        },
                        {
                            "type": "knob",
                            "param": "Attack",
                            "label": "ATTACK",
                            "unit": "s",
                        },
                        {
                            "type": "knob",
                            "param": "Release",
                            "label": "RELEASE",
                            "unit": "s",
                        },
                    ],
                },
            ],
        },
    }

# --- Audio FX DSP Process Hook ---
def process(input_l, input_r, params):
    return [input_l, input_r]

Compressor = True
